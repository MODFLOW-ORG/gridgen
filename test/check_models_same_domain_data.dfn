# GRID_TO_USGDATA and GRID_TO_DISVDATA blocks for the MODFLOW-USG and MODFLOW 6
# checks (check_models.py) on the grid built by check_models_build_same_domain,
# without and with vertical pass-through cells

LOAD check_models_same_domain.dfn

BEGIN GRID_TO_USGDATA check_models_same_domain_usgdata
  GRID = check_models_same_domain
  USG_DATA_PREFIX = check_models/same_domain
END GRID_TO_USGDATA

BEGIN GRID_TO_DISVDATA check_models_same_domain_disvdata
  GRID = check_models_same_domain
  DISV_DATA_PREFIX = check_models/same_domain_disv
END GRID_TO_DISVDATA

BEGIN GRID_TO_USGDATA check_models_same_domain_vp_usgdata
  GRID = check_models_same_domain
  USG_DATA_PREFIX = check_models/same_domain_vp
  VERTICAL_PASS_THROUGH = True
END GRID_TO_USGDATA

BEGIN GRID_TO_DISVDATA check_models_same_domain_vp_disvdata
  GRID = check_models_same_domain
  DISV_DATA_PREFIX = check_models/same_domain_vp_disv
  VERTICAL_PASS_THROUGH = True
END GRID_TO_DISVDATA
