# an active domain that encloses the whole grid without touching it

LOAD action01_buildqtg.dfn

BEGIN ACTIVE_DOMAIN enclosing_domain
  SHAPEFILE = shapefiles/enclosing_domain
  FEATURE_TYPE = polygon
  INCLUDE_BOUNDARY = True
END ACTIVE_DOMAIN

BEGIN QUADTREE_BUILDER buildqtg_enclosing
  MODFLOW_GRID = grid01mfg
  ACTIVE_DOMAIN LAYER 1 = enclosing_domain
  REFINEMENT_FEATURES LAYER 1 = MD_Canals chd_line well_buffer
  SMOOTHING = full
  SMOOTHING_LEVEL_HORIZONTAL = 1
  SMOOTHING_LEVEL_VERTICAL = 1
  GRID_DEFINITION_FILE = grid06qtg.dfn
  TOP LAYER 1 = REPLICATE grid01mfg
  BOTTOM LAYER 1 = REPLICATE grid01mfg
END QUADTREE_BUILDER
