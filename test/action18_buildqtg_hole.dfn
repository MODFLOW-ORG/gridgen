# an active domain and refinement from a polygon with a hole; cells in the
# hole are inactive in layer 1 and not refined in layer 2

LOAD action01_buildqtg.dfn

BEGIN MODFLOW_GRID grid10mfg
  ROTATION_ANGLE = 0.
  X_OFFSET = 543750
  Y_OFFSET = 2792250
  LENGTH_UNIT = undefined
  NLAY = 2
  NROW = 100
  NCOL = 58
  DELR = CONSTANT 800.
  DELC = CONSTANT 800.
  TOP = CONSTANT 5.
  BOTTOM LAYER 1 = CONSTANT -15.
  BOTTOM LAYER 2 = CONSTANT -40.
END MODFLOW_GRID

BEGIN ACTIVE_DOMAIN hole_domain
  SHAPEFILE = shapefiles/polygon_hole
  FEATURE_TYPE = polygon
  INCLUDE_BOUNDARY = False
END ACTIVE_DOMAIN

BEGIN REFINEMENT_FEATURES hole_refinement
  SHAPEFILE = shapefiles/polygon_hole
  FEATURE_TYPE = polygon
  REFINEMENT_LEVEL = 1
END REFINEMENT_FEATURES

BEGIN QUADTREE_BUILDER buildqtg_hole
  MODFLOW_GRID = grid10mfg
  ACTIVE_DOMAIN LAYER 1 = hole_domain
  REFINEMENT_FEATURES LAYER 2 = hole_refinement
  SMOOTHING = none
  GRID_DEFINITION_FILE = grid10qtg.dfn
END QUADTREE_BUILDER
