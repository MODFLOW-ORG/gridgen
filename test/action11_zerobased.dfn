LOAD grid05qtg.dfn

BEGIN GRID_TO_USGDATA grid05qtg-to-usgdata
  GRID = grid05qtg
  USG_DATA_PREFIX = output_usgdata/grid05qtg
END GRID_TO_USGDATA

BEGIN GRID_TO_SHAPEFILE grid05qtg-to-polyshapefile
  GRID = grid05qtg
  SHAPEFILE = output_shapefiles/grid05qtg
  FEATURE_TYPE = polygon
END GRID_TO_SHAPEFILE

BEGIN GRID_TO_VTKFILE grid05qtg-to-vtkfile
  GRID = grid05qtg
  VTKFILE = output_vtkfiles/grid05qtg
  SHARE_VERTEX = False
END GRID_TO_VTKFILE
