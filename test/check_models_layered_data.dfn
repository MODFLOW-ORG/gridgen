# GRID_TO_USGDATA blocks for the MODFLOW 6 and MODFLOW-USG checks
# (check_models.py) on the grid built by check_models_build_layered

LOAD check_models_layered.dfn

BEGIN GRID_TO_USGDATA check_models_layered_gncv
  GRID = check_models_layered
  USG_DATA_PREFIX = check_models/layered_gncv
  GNC_VERTICAL = True
END GRID_TO_USGDATA

BEGIN GRID_TO_USGDATA check_models_layered_vp_gncv
  GRID = check_models_layered
  USG_DATA_PREFIX = check_models/layered_vp_gncv
  VERTICAL_PASS_THROUGH = True
  GNC_VERTICAL = True
END GRID_TO_USGDATA
