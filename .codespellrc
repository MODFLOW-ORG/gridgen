[codespell]
skip = *.pdf,*.bst,*.log,*.aux,*.bbl,*.blg,*.out,*.toc,*.fls,*.fdb_latexmk,*.synctex.gz,*.asc,*.csv,*.shp,*.shx,*.dbf,*.prj,./.pixi,./builddir,./src/tools/shapefile/shapelib,./subprojects/googletest*,./subprojects/packagecache,./bin,./test/check_models,*.dat,*.vtu,*.ifo,*.nod,./doc/ReleaseNotes/previous,./doc/ReleaseNotes/Figures,pixi.lock
# identifiers in the C++ source: the area sign of points a, b, and d, and the COO sparse matrix format
ignore-words-list = abd,coo
